# GraphQL schema for WatchTower (updated)

type User {
  id: ID!
  email: String!
  name: String!
}

type Comment {
  id: ID!
  text: String!
  author: User
  createdAt: String!
}

type Incident {
  id: ID!
  title: String!
  severity: String!
  status: String!
  details: String
  assignee: User
  comments: [Comment!]
}

type AuthPayload {
  token: String!
  user: User!
}

type Query {
  incidents(status: String): [Incident!]
  incident(id: ID!): Incident
  me: User
}

type Mutation {
  login(email: String!, password: String!): AuthPayload!
  acknowledgeIncident(incidentId: ID!): Incident!
  addComment(incidentId: ID!, text: String!): Comment!
  registerPushToken(token: String!): User
}

type Subscription {
  onNewIncident: Incident!
  onIncidentUpdate(incidentId: ID!): Incident!
}
